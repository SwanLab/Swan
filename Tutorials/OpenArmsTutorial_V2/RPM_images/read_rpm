"""
read_rpm.py
-----------
Lit automatiquement la valeur RPM sur chaque image du dossier RPM_images
via OpenCV (détection d'aiguille par seuillage + PCA), puis écrit les
valeurs dans la colonne "rpm" de ../merged_output.csv.

Cadran : 0 RPM en bas (90° opencv), 500 RPM en haut-droite (20° opencv)
         L'aiguille tourne en sens horaire visuel (croissant opencv en passant par 360°)
         Arc total : 290°

Structure attendue :
    OpenArmsTutorial_V2/
    ├── merged_output.csv
    └── RPM_images/
        ├── read_rpm.py
        ├── captura_18-04-47.jpg
        └── ...

Prérequis :
    pip install opencv-python-headless pandas numpy

Usage :
    source venv/bin/activate
    python read_rpm.py
"""

import random
import re
import sys
from pathlib import Path

import cv2
import numpy as np
import pandas as pd

# ── Chemins ───────────────────────────────────────────────────────────────────
SCRIPT_DIR = Path(__file__).parent
CSV_PATH   = SCRIPT_DIR.parent / "merged_output.csv"

# ── Dates de la traversée ─────────────────────────────────────────────────────
# Les images 18:xx→23:xx correspondent au 2025-05-15
# Les images 00:xx→10:xx correspondent au 2025-05-16
DATE_EVENING = "2025-05-15"   # heures >= MIDNIGHT_HOUR
DATE_MORNING = "2025-05-16"   # heures <  MIDNIGHT_HOUR
MIDNIGHT_HOUR = 12            # seuil : < 12h = lendemain, >= 12h = veille

# ── Paramètres du cadran (image 640x480, caméra fixe) ────────────────────────
CROP        = (80, 245, 200, 235) # (x, y, w, h) dans l'image originale
CENTER      = (90, 140)           # centre de l'aiguille dans le crop
RADIUS      = 70                  # rayon utile du cadran (px)
HUB_RADIUS  = 15                  # rayon du moyeu à ignorer (px)

# Calibration angles (convention trigonométrique : 0°=droite, sens antihoraire)
# Points obtenus via calibrate.py — 4 points pour interpolation par morceaux
# Format : (angle_trigo, valeur_rpm)
# L'aiguille tourne en sens horaire visuel = décroissant en trigo
CALIBRATION_POINTS = [
    (85,  0),    # aiguille pointe vers le bas
    (41,  200),
    (19,  300),
    (332, 500),  # aiguille pointe vers haut-droite
]

SUPPORTED_EXT = {".jpg", ".jpeg", ".png", ".bmp", ".tiff", ".webp"}

# ── Mode debug ────────────────────────────────────────────────────────────────
# Sauvegarde N images choisies aléatoirement et réparties sur tout le dataset,
# avec l'aiguille détectée superposée. Change à chaque run (pas de seed fixe).
# Mettre à 0 pour désactiver.
DEBUG_N_IMAGES = 10


# ── Détection RPM ─────────────────────────────────────────────────────────────

def angle_to_rpm_piecewise(needle_trigo: float) -> float | None:
    """
    Convertit un angle (convention trigo) en RPM via interpolation par morceaux.
    Utilise les 4 points de CALIBRATION_POINTS.
    L'aiguille tourne en sens HORAIRE visuel = décroissant en trigo.
    """
    pts = CALIBRATION_POINTS  # [(angle, rpm), ...] décroissant en angle

    # Normaliser l'aiguille : on travaille en "distance horaire depuis le 0 RPM"
    # Distance horaire trigo = décroissante mod 360
    angle_0 = pts[0][0]

    def horaire_dist(a):
        """Distance parcourue en sens horaire depuis angle_0."""
        return (angle_0 - a) % 360

    needle_dist = horaire_dist(needle_trigo)

    # Construire les segments [(dist_debut, dist_fin, rpm_debut, rpm_fin)]
    segments = []
    for i in range(len(pts) - 1):
        a1, r1 = pts[i]
        a2, r2 = pts[i+1]
        d1 = horaire_dist(a1)
        d2 = horaire_dist(a2)
        segments.append((d1, d2, r1, r2))

    # Trouver le segment contenant needle_dist
    for d1, d2, r1, r2 in segments:
        if d1 <= needle_dist <= d2:
            ratio = (needle_dist - d1) / (d2 - d1)
            return r1 + ratio * (r2 - r1)

    # needle_dist est en dehors de [0, total_arc] (la valeur étant un modulo 360,
    # cela signifie que l'aiguille est dans la zone arrière du cadran, ex: zone
    # rouge ou zone morte). On tolère une petite marge de 5% pour absorber le
    # bruit de mesure tout proche des bornes 0 RPM et 500 RPM.
    total_arc = horaire_dist(pts[-1][0])
    margin = total_arc * 0.05

    if -margin <= needle_dist < 0:
        return float(pts[0][1])          # tout proche de 0 RPM, on clampe à 0
    if total_arc < needle_dist <= total_arc + margin:
        return float(pts[-1][1])         # tout proche de 500 RPM, on clampe à 500

    # Sinon : franchement hors plage → lecture invalide
    return None


def make_unreadable_debug_image(image_path: Path):
    """
    Construit une image debug pour une image dont la lecture a échoué.
    Affiche le crop brut (ou un placeholder gris si même la lecture du
    fichier a échoué) avec une grande croix rouge et le texte UNREADABLE.
    """
    img = cv2.imread(str(image_path))
    x, y, w, h = CROP

    if img is not None:
        crop = img[y:y+h, x:x+w].copy()
    else:
        crop = np.full((h, w, 3), 60, dtype=np.uint8)  # placeholder gris

    dbg = cv2.resize(crop, (crop.shape[1]*2, crop.shape[0]*2))
    H, W = dbg.shape[:2]

    # Grande croix rouge en diagonale
    cv2.line(dbg, (0, 0), (W, H), (0, 0, 255), 3)
    cv2.line(dbg, (W, 0), (0, H), (0, 0, 255), 3)

    # Bandeau de texte
    cv2.rectangle(dbg, (0, 0), (W, 26), (0, 0, 200), -1)
    cv2.putText(dbg, "UNREADABLE", (8, 19),
                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)

    return dbg


def detect_rpm(image_path: Path, debug: bool = False):
    """
    Retourne (rpm, debug_img) si debug=True, sinon juste rpm.
    rpm est un float ou None si illisible. Ne lève jamais d'exception.
    """
    try:
        img = cv2.imread(str(image_path))
        if img is None:
            return None

        x, y, w, h = CROP
        crop = img[y:y+h, x:x+w]
        cx, cy = CENTER

        gray = cv2.cvtColor(crop, cv2.COLOR_BGR2GRAY)

        # Masque circulaire
        mask = np.zeros_like(gray)
        cv2.circle(mask, (cx, cy), RADIUS, 255, -1)
        gray_m = cv2.bitwise_and(gray, gray, mask=mask)

        # Seuillage adaptatif (robuste aux variations de luminosité)
        blur = cv2.GaussianBlur(gray_m, (5, 5), 0)
        _, thresh = cv2.threshold(blur, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
        thresh = cv2.bitwise_and(thresh, thresh, mask=mask)

        # Supprimer le moyeu et le bord extérieur
        cv2.circle(thresh, (cx, cy), HUB_RADIUS, 0, -1)
        border = np.zeros_like(thresh)
        cv2.circle(border, (cx, cy), RADIUS - 5, 255, -1)
        thresh = cv2.bitwise_and(thresh, border)

        points = np.column_stack(np.where(thresh > 0))
        if len(points) < 20:
            return None

        # PCA → direction principale
        data = points[:, ::-1].astype(np.float32)
        mean, eigvecs = cv2.PCACompute(data, mean=None)

        angle1 = np.degrees(np.arctan2(eigvecs[0, 1], eigvecs[0, 0]))
        angle2 = angle1 + 180

        # Choisir la direction qui s'éloigne du centre
        mx, my = float(mean[0, 0]), float(mean[0, 1])
        dx, dy = mx - cx, my - cy
        dot1 = dx * np.cos(np.radians(angle1)) + dy * np.sin(np.radians(angle1))
        dot2 = dx * np.cos(np.radians(angle2)) + dy * np.sin(np.radians(angle2))
        needle = (angle1 if dot1 > dot2 else angle2) % 360

        # Mapping angle → RPM par interpolation par morceaux (piecewise linear)
        rpm = angle_to_rpm_piecewise(needle)
        if rpm is None:
            if debug: return None, None
            return None

        # ── Image debug ───────────────────────────────────────────────────
        if debug:
            dbg = cv2.cvtColor(crop, cv2.COLOR_BGR2RGB) if False else crop.copy()
            cx4, cy4 = cx * 2, cy * 2
            dbg = cv2.resize(dbg, (dbg.shape[1]*2, dbg.shape[0]*2))
            R2 = RADIUS * 2

            # Cercle de travail
            cv2.circle(dbg, (cx4, cy4), R2, (0, 255, 0), 1)
            # Centre
            cv2.circle(dbg, (cx4, cy4), 5, (0, 0, 255), -1)

            # Aiguille détectée (opencv angle)
            needle_cv = (-needle) % 360
            rad = np.radians(needle_cv)
            ex = int(cx4 + R2 * np.cos(rad))
            ey = int(cy4 + R2 * np.sin(rad))
            cv2.arrowedLine(dbg, (cx4, cy4), (ex, ey), (0, 0, 255), 2, tipLength=0.2)

            # Points de calibration
            cal_colors = [(0,200,0),(255,100,0),(255,165,0),(0,0,255)]
            for (a_trigo, rpm_ref), col in zip(CALIBRATION_POINTS, cal_colors):
                a_cv = (-a_trigo) % 360
                r2 = np.radians(a_cv)
                px = int(cx4 + (R2-10) * np.cos(r2))
                py = int(cy4 + (R2-10) * np.sin(r2))
                cv2.circle(dbg, (px, py), 5, col, -1)
                cv2.putText(dbg, str(rpm_ref), (px+4, py-4),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.4, col, 1)

            # Valeur RPM
            cv2.putText(dbg, f"{round(rpm)} RPM", (8, 20),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
            # Masque seuillage (petit, en bas à droite)
            th_small = cv2.resize(thresh, (thresh.shape[1], thresh.shape[0]))
            th_rgb = cv2.cvtColor(th_small, cv2.COLOR_GRAY2BGR)
            th_rgb2 = cv2.resize(th_rgb, (dbg.shape[1]//3, dbg.shape[0]//3))
            dbg[-th_rgb2.shape[0]:, -th_rgb2.shape[1]:] = th_rgb2

            return round(rpm), dbg

        return round(rpm)

    except Exception:
        if debug: return None, None
        return None


# ── Interpolation ─────────────────────────────────────────────────────────────

def interpolate_missing(df: pd.DataFrame) -> tuple[pd.DataFrame, int, int]:
    """Remplace les NaN par la moyenne du voisin valide avant + après."""
    rpm = df["rpm"].copy()
    missing_idx = rpm[rpm.isna()].index
    filled = 0

    for idx in missing_idx:
        pos = df.index.get_loc(idx)
        prev_val = next((rpm.iloc[p] for p in range(pos - 1, -1, -1) if pd.notna(rpm.iloc[p])), None)
        next_val = next((rpm.iloc[p] for p in range(pos + 1, len(rpm))  if pd.notna(rpm.iloc[p])), None)

        if prev_val is not None and next_val is not None:
            rpm.at[idx] = round((prev_val + next_val) / 2)
        elif prev_val is not None:
            rpm.at[idx] = prev_val
        elif next_val is not None:
            rpm.at[idx] = next_val

        if pd.notna(rpm.at[idx]):
            filled += 1

    df["rpm"] = rpm
    return df, len(missing_idx), filled


# ── Utilitaires ───────────────────────────────────────────────────────────────

def parse_image_time(filename: str) -> str:
    """
    'captura_18-04-47.jpg' → '2025-05-15 18:04:47'
    'captura_00-00-06.jpg' → '2025-05-16 00:00:06'
    """
    m = re.search(r'(\d{2})-(\d{2})-(\d{2})', filename)
    if not m:
        raise ValueError(f"Heure introuvable dans : {filename}")
    hh, mm, ss = m.group(1), m.group(2), m.group(3)
    date = DATE_MORNING if int(hh) < MIDNIGHT_HOUR else DATE_EVENING
    return f"{date} {hh}:{mm}:{ss}"


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    if not CSV_PATH.exists():
        print(f"Erreur : CSV introuvable → {CSV_PATH}")
        sys.exit(1)

    images = sorted([f for f in SCRIPT_DIR.iterdir() if f.suffix.lower() in SUPPORTED_EXT])
    if not images:
        print(f"Aucune image trouvée dans {SCRIPT_DIR}")
        sys.exit(1)

    print(f"{len(images)} images trouvées.\n")

    # Indices (1-based) des images à sauvegarder en mode debug, tirés au hasard
    # sur l'ensemble du dataset (différents à chaque exécution)
    debug_indices = set()
    if DEBUG_N_IMAGES > 0:
        n_pick = min(DEBUG_N_IMAGES, len(images))
        debug_indices = set(random.sample(range(1, len(images) + 1), n_pick))

    df = pd.read_csv(CSV_PATH)
    if "Time" not in df.columns:
        print(f"Erreur : colonne 'Time' absente. Colonnes : {list(df.columns)}")
        sys.exit(1)

    df["_time_dt"] = pd.to_datetime(df["Time"])  # conversion en datetime pour nearest-match
    if "rpm" not in df.columns:
        df["rpm"] = pd.NA

    unreadable = 0

    for i, img_path in enumerate(images, 1):
        try:
            img_time = parse_image_time(img_path.name)
        except ValueError as e:
            print(f"[{i}/{len(images)}] {img_path.name} → IGNORÉ ({e})")
            continue

        print(f"[{i}/{len(images)}] {img_path.name}  ({img_time})", end=" → ")

        show_debug = (i in debug_indices)
        if show_debug:
            rpm, dbg_img = detect_rpm(img_path, debug=True)
        else:
            rpm = detect_rpm(img_path)
            dbg_img = None

        if show_debug:
            debug_dir = SCRIPT_DIR / "debug"
            debug_dir.mkdir(exist_ok=True)
            out_path = debug_dir / f"debug_{i:04d}_{img_path.stem}.jpg"

            if dbg_img is not None:
                cv2.imwrite(str(out_path), dbg_img)
            else:
                # Image illisible : on sauvegarde quand même le crop brut,
                # annoté pour que ce soit visible immédiatement au survol.
                unreadable_img = make_unreadable_debug_image(img_path)
                cv2.imwrite(str(out_path), unreadable_img)

        img_dt = pd.to_datetime(img_time)
        deltas = (df["_time_dt"] - img_dt).abs()
        min_delta = deltas.min()
        closest_idx = deltas.idxmin()

        if min_delta.total_seconds() > 8:
            # Image hors plage temporelle : on ne touche pas le CSV
            print(f"hors plage CSV (écart min : {min_delta.total_seconds():.1f}s)")
        elif rpm is None:
            # Image illisible : marquer la ligne CSV en NaN pour interpolation
            df.loc[closest_idx, "rpm"] = float("nan")
            print(f"illisible → ligne {closest_idx} marquée NaN (sera interpolée)")
            unreadable += 1
        else:
            df.loc[closest_idx, "rpm"] = rpm
            print(f"{rpm} RPM  (ligne {closest_idx}, écart {min_delta.total_seconds():.1f}s)")

    # Interpolation
    print(f"\n── Interpolation ────────────────────────────────────")
    print(f"Images illisibles : {unreadable}/{len(images)}")
    df, total_missing, filled = interpolate_missing(df)
    print(f"Valeurs interpolées : {filled}/{total_missing}")
    if total_missing - filled:
        print(f"Valeurs restées NaN : {total_missing - filled}")

    df.drop(columns=["_time_dt"], inplace=True)
    df.to_csv(CSV_PATH, index=False)
    print(f"\nTerminé ! CSV mis à jour : {CSV_PATH}")


if __name__ == "__main__":
    main()