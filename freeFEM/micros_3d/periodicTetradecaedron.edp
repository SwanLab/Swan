// Read mesh
string meshFileName = "mallaGMESH";
mesh3 Th = readmesh3(meshFileName);
//plot(Th, wait=false);

// Create master-slave array
ifstream file("MS.txt");
int pairs;
file >> pairs;
cout << pairs << endl;

int[int] master(pairs), slave(pairs);
for (int i = 1; i < pairs+1; i++)
{    
    file >> master[i] >> slave[i];
    //cout << master[i] << ";" << slave[i] << endl;
}
cout << "Initial values" << master[0] << slave[0] << endl;

// Compute elasticity problem
// 1. Set variable
fespace Vh3(Th,[P2,P2,P2]);
Vh3 [ux,uy,uz], [vx,vy,vz];
// 2. Set material
real E, nu, lambda, mu;
E = 1;
nu = 0.3;
lambda = E*nu/((1+nu)*(1-nu));
mu     = E/(2*(1+nu));
cout << lambda << ";" << mu << endl;

