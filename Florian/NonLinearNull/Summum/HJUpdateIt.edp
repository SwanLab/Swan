IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");
real [int] phiVal = importArray("phiVal");
real [int] gVal = importArray("gVal");
real [int] nxVal = importArray("nxVal");
real [int] nyVal = importArray("nyVal");
real dt = importVar("dTime");
real isLs = importVar("isLs");

fespace Vh(Th,P1);
Vh phio, phi, g, nx, ny, gx, gy;

nx[] = nxVal;
ny[] = nyVal;

g[] = gVal;
gx = g*nx;
gy = g*ny;

func real[int] advectRedist(real[int] phiot, real[int] vxt, real[int] vyt, real step) {
   Vh phi,phio=phiot,velx=vxt,vely=vyt;
   phi = convect([velx,vely],-step,phio);
   return phi[];
} // EOM

phio[] = phiVal;
phio[] = advectRedist(phio[],gx[],gy[],1.0/dt);

if (isLs==1) {
  distance(Th,phio,phi[]); 
} else {
  phi[] = phio[];
}

exportArray(phi[]);