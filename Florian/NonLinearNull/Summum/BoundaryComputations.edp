IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");
real [int] phiVal = importArray("phiVal");
real alpha = importVar("alpha");

fespace Vh(Th,P1);
fespace Vh0(Th,P0);
Vh phi, nx, ny, nNorm, kappa, v;
Vh0 kappa0;
phi[] = phiVal;

problem projNx(nx,v) = int2d(Th)(0.0001*(dx(nx)*dx(v)+dy(nx)*dy(v)) + nx*v) - int2d(Th)(dx(phi)*v);

problem projNy(ny,v) = int2d(Th)(0.0001*(dx(ny)*dx(v)+dy(ny)*dy(v)) + ny*v) - int2d(Th)(dy(phi)*v);

projNx;
projNy;

nNorm = sqrt(nx*nx + ny*ny + 1.e-12);
nx = nx/nNorm;
ny = ny/nNorm;

kappa0 = dx(nx)+dy(ny);

problem regKappa(kappa,v) = int2d(Th)((alpha^2.0)*(dx(kappa)*dx(v)+dy(kappa)*dy(v)) + kappa*v)
                    - int2d(Th)(kappa0*v);

regKappa;

exportArray(nx[]);
exportArray(ny[]);
exportArray(kappa[]);