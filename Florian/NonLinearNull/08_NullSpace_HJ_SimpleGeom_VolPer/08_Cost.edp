IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");
real [int] phiVal = importArray("phiVal");

fespace Vh(Th,P1);
Vh phi, dOmR, dOm;
phi[] = phiVal;

dOmR = phi;
for (int i = 0; i < Th.nbe; i++) {
    dOmR[][Th.be(i)[0]] = 0.;
    dOmR[][Th.be(i)[1]] = 0.;
}
distance(Th,dOmR,dOm[]);

real J = 0.5*int2d(Th)(dOm^2.0);

exportVar(J);