IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");

/* Finite Element spaces */
fespace Vh(Th,P1);
fespace Vh0(Th,P0);

/* Initialization of the Level Set function */
func real initialGuess() {
  real ls;
  ls = sqrt(x^2+y^2)-(1+0.35*cos(5*atan2(y,x)));
  return(ls);
}
Vh phio, phi;
phio = initialGuess();

distance(Th,phio,phi[]);

exportArray(phi[]);
