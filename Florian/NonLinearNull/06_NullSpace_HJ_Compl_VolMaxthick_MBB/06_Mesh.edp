IMPORT "io.edp"

real fac = 6.0;
int labelDir1 = 1;
int labelDir2 = 2;
int labelNeu  = 3;
border left(t=0.0,1.0){ x=-3.0; y=1.0-t; label=0; };
border botLeft(t=0.0,0.02){ x=-3.0+3*t; y=0.0; label=labelDir1; };
border bot(t=0.02,1.98){ x=-3.0+3*t; y=0.0; label=0; };
border botRight(t=1.98,2.0){ x=-3.0+3*t; y=0.0; label=labelDir2; };
border right(t=0.0,1.0){ x=3.0; y=t; label=0; };
border topRight(t=0.0,0.94){ x=3.0-3*t; y=1.0; label=0; };
border top(t=0.94,1.06){ x=3.0-3*t; y=1.0; label=labelNeu; };
border topLeft(t=1.06,2.0){ x=3.0-3*t; y=1.0; label=0; };
mesh Th = buildmesh(left(17*fac)+botLeft(fac)+bot(98*fac)+botRight(fac)+right(17*fac)+
          topRight(47*fac)+top(6*fac)+topLeft(47*fac));

real meshsiz = 0.02*3.0/fac;
real alpha = 2.0*meshsiz;
real beta  = 8.0*meshsiz;

exportMesh(Th);
exportVar(alpha);
exportVar(beta);
exportVar(labelDir1);
exportVar(labelDir2);
exportVar(labelNeu);
exportVar(meshsiz);