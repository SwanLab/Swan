IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");
real [int] phiVal1 = importArray("phiVal1");
real [int] phiVal2 = importArray("phiVal2");
real alpha = importVar("alpha");

fespace Vh(Th,P1);
Vh dOm, phi, phi1, phi2, nx, ny, kappa, v;
phi1[] = phiVal1;
phi2[] = phiVal2;
for (int i = 0; i < Vh.ndof; ++i) {
  phi[][i] = max(phiVal1[i],phiVal2[i]); /* Intersection */
}
distance(Th,phi,dOm[]);

problem projNx(nx,v) = int2d(Th)(nx*v) - int2d(Th)(dx(dOm)*v);

problem projNy(ny,v) = int2d(Th)(ny*v) - int2d(Th)(dy(dOm)*v);

projNx;
projNy;

problem regKappa(kappa,v) = int2d(Th)(alpha^2.0*(dx(kappa)*dx(v)+dy(kappa)*dy(v)) + kappa*v)
                    - int2d(Th)((dx(nx)+dy(ny))*v);

regKappa;

exportArray(nx[]);
exportArray(ny[]);
exportArray(kappa[]);