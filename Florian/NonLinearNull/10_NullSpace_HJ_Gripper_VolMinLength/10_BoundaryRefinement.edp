IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");
real [int] phiVal1 = importArray("phiVal1");
real [int] phiVal2 = importArray("phiVal2");
real alpha = importVar("alpha");

fespace Vh(Th,P1);
fespace Vh0(Th,P0);
Vh dOm, phi, phi1, phi2, nx, ny, kappa, v;
Vh0 kappa0;
phi1[] = phiVal1;
phi2[] = phiVal2;
for (int i = 0; i < Vh.ndof; ++i) {
  phi[][i] = max(phiVal1[i],phiVal2[i]); /* Intersection */
}
distance(Th,phi,dOm[]);

problem projNx(nx,v) = int2d(Th)(0.0001*(dx(nx)*dx(v)+dy(nx)*dy(v)) + nx*v)
 - int2d(Th)((dx(dOm)/sqrt(dx(dOm)*dx(dOm)+dy(dOm)*dy(dOm) + 1.e-12))*v);

problem projNy(ny,v) = int2d(Th)(0.0001*(dx(ny)*dx(v)+dy(ny)*dy(v)) + ny*v)
 - int2d(Th)((dy(dOm)/sqrt(dx(dOm)*dx(dOm)+dy(dOm)*dy(dOm) + 1.e-12))*v);

projNx;
projNy;

kappa0 = dx(nx)+dy(ny);

problem regKappa(kappa,v) = int2d(Th)(alpha*(dx(kappa)*dx(v)+dy(kappa)*dy(v)) + kappa*v)
                    - int2d(Th)(kappa0*v);

regKappa;

exportArray(nx[]);
exportArray(ny[]);
exportArray(kappa[]);