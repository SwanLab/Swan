IMPORT "io.edp"
load "distance"
load "mmg"

mesh Th = importMesh("Th");
real [int] phiVal1 = importArray("phiVal1");
real [int] phiVal2 = importArray("phiVal2");
real [int] gVal = importArray("gVal");
real [int] nxVal = importArray("nxVal");
real [int] nyVal = importArray("nyVal");
real dt = importVar("dTime");

fespace Vh(Th,P1);
Vh phio, phi1, phi2, g, nx1, ny1, gx, gy;

nx1[] = nxVal;
ny1[] = nyVal;

g[] = gVal;
gx = g*nx1;
gy = g*ny1;

func real[int] advectRedist(real[int] phiot, real[int] vxt, real[int] vyt, real step) {
   Vh phi,phitmp,phio=phiot,velx=vxt,vely=vyt;
   phitmp = convect([velx,vely],-step,phio);
   distance(Th,phitmp,phi[]);
  
   return phi[];
} // EOM

phio[] = phiVal1;
phi1[] = advectRedist(phio[],gx[],gy[],1.0/dt);

phio[] = phiVal2;
phi2[] = advectRedist(phio[],gx[],gy[],1.0/dt);

exportArray(phi1[]);
exportArray(phi2[]);
