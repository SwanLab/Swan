IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");
mesh Th2 = importMesh("Th2");
real [int] phiVal1 = importArray("phiVal1");
real [int] phiVal2 = importArray("phiVal2");
real dmin = importVar("dmin");
real p = importVar("p");

int [int] pOmega(7);
pOmega[0] = 0;
pOmega[1] = 1;
pOmega[2] = 2;
pOmega[3] = 3;
pOmega[4] = 4;
pOmega[5] = 5;
pOmega[6] = 10;

fespace Vh(Th,P1);
Vh phi1, phi2, dOm1, dOm2, chi1, chi2;
phi1[] = phiVal1;
phi2[] = phiVal2;

for (int i = 0; i < Th.nbe; i++) {
    phi1[][Th.be(i)[0]] = 0.;
    phi1[][Th.be(i)[1]] = 0.;
}

distance(Th,phi1,dOm1[]);
distance(Th,phi2,dOm2[]);

chi1 = exp(-(50.0*dOm1)^2);
chi2 = exp(-(50.0*dOm2)^2);

real P12 = (int1d(Th2,pOmega)(chi1/((abs(dOm2)+chi2)^p)))^(-1/p); /* int partial Omega 1 */
real P21 = (int1d(Th2,pOmega)(chi2/((abs(dOm1)+chi1)^p)))^(-1/p); /* int partial Omega 2 */
real H = - 2/(1/P12 + 1/P21) + dmin;

exportVar(H);