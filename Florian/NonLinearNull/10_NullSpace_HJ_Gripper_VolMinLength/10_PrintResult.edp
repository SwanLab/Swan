IMPORT "io.edp"
load "iovtk"

mesh Th = importMesh("Th");
real [int] phiVal1 = importArray("phiVal1");
real [int] phiVal2 = importArray("phiVal2");

fespace Vh(Th,P1);
Vh phi1, phi2;
phi1[] = phiVal1;
phi2[] = phiVal2;

string sout;
sout = "10_ResultLs1.vtu";
savevtk(sout, Th, phi1, dataname="LevelSet1");

sout = "10_ResultLs2.vtu";
savevtk(sout, Th, phi2, dataname="LevelSet2");
