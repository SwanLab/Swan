IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");
mesh Th2 = importMesh("Th2");
real [int] phiVal1 = importArray("phiVal1");
real [int] phiVal2 = importArray("phiVal2");
real alpha = importVar("alpha");
real beta = importVar("beta");
real lsLab = importVar("lsLab");
real p = importVar("p");
real [int] nxVal = importArray("nx");
real [int] nyVal = importArray("ny");

int [int] pOmega(7);
pOmega[0] = 0;
pOmega[1] = 1;
pOmega[2] = 2;
pOmega[3] = 3;
pOmega[4] = 4;
pOmega[5] = 5;
pOmega[6] = 10;

fespace Vh(Th,P1);
fespace Vh0(Th,P0);
Vh phi1, phi2, g, dOm1, dOm2, chi1, chi2, nx, ny, v;
phi1[] = phiVal1;
phi2[] = phiVal2;
nx[]   = nxVal;
ny[]   = nyVal;

Vh0 kappa;
kappa = dx(nx)+dy(ny);

for (int i = 0; i < Th.nbe; i++) {
    phi1[][Th.be(i)[0]] = 0.;
    phi1[][Th.be(i)[1]] = 0.;
}

distance(Th,phi1,dOm1[]);
distance(Th,phi2,dOm2[]);

chi1 = 0.5*(1+tanh(dOm1/alpha));
chi2 = 0.5*(1+tanh(dOm2/alpha));

int [int] lsLabel(1);
lsLabel[0] = lsLab;

real P12 = (int1d(Th2,pOmega)(chi1/((abs(dOm2)+chi2)^p)))^(-1/p); /* int partial Omega 1  explain denom.. */
real P21 = (int1d(Th2,pOmega)(chi2/((abs(dOm1)+chi1)^p)))^(-1/p); /* int partial Omega 2 */
real p12 = -2*P12^2/((P12+P21)^2);
real p21 = -2*P21^2/((P12+P21)^2);

Vh dxdOm1, dydOm1, w1, lapldOm1, dxdOm2, dydOm2, w2, lapldOm2;

problem gradxPhi1(dxdOm1,v) = int2d(Th)(dxdOm1*v + alpha^2*(dx(dxdOm1)*dx(v)+dy(dxdOm1)*dy(v)))
                        -int2d(Th)(dx(dOm1)*v);

problem gradyPhi1(dydOm1,v) = int2d(Th)(dydOm1*v + alpha^2*(dx(dydOm1)*dx(v)+dy(dydOm1)*dy(v)))
                        -int2d(Th)(dy(dOm1)*v);

gradxPhi1;
gradyPhi1;

problem laplace1(lapldOm1,v) = int2d(Th)(lapldOm1*v + alpha^2*(dx(lapldOm1)*dx(v)+dy(lapldOm1)*dy(v)))
                        -int2d(Th)((dx(dxdOm1) + dy(dydOm1))*v);

laplace1;

problem gradxPhi2(dxdOm2,v) = int2d(Th)(dxdOm2*v + alpha^2*(dx(dxdOm2)*dx(v)+dy(dxdOm2)*dy(v)))
                        -int2d(Th)(dx(dOm2)*v);

problem gradyPhi2(dydOm2,v) = int2d(Th)(dydOm2*v + alpha^2*(dx(dydOm2)*dx(v)+dy(dydOm2)*dy(v)))
                        -int2d(Th)(dy(dOm2)*v);

gradxPhi2;
gradyPhi2;

problem laplace2(lapldOm2,v) = int2d(Th)(lapldOm2*v + alpha^2*(dx(lapldOm2)*dx(v)+dy(lapldOm2)*dy(v)))
                        -int2d(Th)((dx(dxdOm2) + dy(dydOm2))*v);

laplace2;

real q = 3.5, r = 3.5;
w1 = 2/(1+abs(dOm1)^q*abs(lapldOm1)^r);
w2 = 2/(1+abs(dOm2)^q*abs(lapldOm2)^r);

fespace Vh2(Th2,P1);
Vh2 u12, u21, rhs12, rhs21, v2, g2;

problem uTerm12(u12,v2) = int1d(Th2,pOmega)(chi2*u12*v2) + int2d(Th2)(w2*(dxdOm2*dx(u12)+dydOm2*dy(u12))*(dxdOm2*dx(v2)+dydOm2*dy(v2)))
                        - int1d(Th2,pOmega)(chi1*((p*abs(dOm2)^p)/(dOm2^(2*p+1)+chi2))*v2);

uTerm12;

problem uTerm21(u21,v2) = int1d(Th2,pOmega)(chi1*u21*v2) + int2d(Th2)(w1*(dxdOm1*dx(u21)+dydOm1*dy(u21))*(dxdOm1*dx(v2)+dydOm1*dy(v2)))
                        - int1d(Th2,pOmega)(chi2*((p*abs(dOm1)^p)/(dOm1^(2*p+1)+chi1))*v2);

uTerm21;

rhs12 = -P12^(1+p)*(-chi1*abs(dOm2)^p/(dOm2^(2*p+1)+chi2)*(dxdOm2*nx+dydOm2*ny)+chi1*kappa/(p*abs(dOm2)^p+chi2)+chi2*u12/p);
rhs21 = -P21^(1+p)*(-chi2*abs(dOm1)^p/(dOm1^(2*p+1)+chi1)*(dxdOm1*nx+dydOm1*ny)+chi2*kappa/(p*abs(dOm1)^p+chi1)+chi1*u21/p);

problem velext(g2,v2) = int2d(Th2)(g2*v2 + beta^2*(dx(g2)*dx(v2)+dy(g2)*dy(v2)))
                        -int1d(Th2,lsLabel)(-beta*(p21*rhs12+p12*rhs21)*v2);

velext;
g = g2;

exportArray(g[]);