IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");
mesh Th1 = importMesh("Th1");
mesh Th2 = importMesh("Th2");
mesh Th12 = importMesh("Th12");
real [int] phiVal1 = importArray("phiVal1");
real [int] phiVal2 = importArray("phiVal2");
real alpha = importVar("alpha");
real beta = importVar("beta");
real lsLab = importVar("lsLab");
real p = importVar("p");
real [int] nxVal = importArray("nx");
real [int] nyVal = importArray("ny");

int [int] pOm1(7);
pOm1[0] = 0;
pOm1[1] = 1;
pOm1[2] = 2;
pOm1[3] = 3;
pOm1[4] = 4;
pOm1[5] = 5;
pOm1[6] = 10;

fespace Vh(Th,P1);
fespace Vh0(Th,P0);
Vh phi1, phi2, g, dOm1, dOm2, chi1, chi2, nx, ny, v;
phi1[] = phiVal1;
phi2[] = phiVal2;
nx[]   = nxVal;
ny[]   = nyVal;

Vh0 kappa;
kappa = dx(nx)+dy(ny);

for (int i = 0; i < Th.nbe; i++) {
    phi1[][Th.be(i)[0]] = 0.;
    phi1[][Th.be(i)[1]] = 0.;
}

distance(Th,phi1,dOm1[]);
distance(Th,phi2,dOm2[]);

chi1 = exp(-(100.0*dOm1)^2);
chi2 = exp(-(100.0*dOm2)^2);

int [int] lsLabel(1);
lsLabel[0] = lsLab;

real P12 = (int1d(Th1,pOm1)(1/((abs(dOm2))^p)))^(-1/p);
real P21 = (int1d(Th2,lsLabel)(1/((abs(dOm1))^p)))^(-1/p);
real p12 = -2*P12^2/((P12+P21)^2);
real p21 = -2*P21^2/((P12+P21)^2);

Vh dxdOm1, dydOm1, w1, lapldOm1, dxdOm2, dydOm2, w2, lapldOm2;

problem gradxPhi1(dxdOm1,v) = int2d(Th)(dxdOm1*v + alpha^2*(dx(dxdOm1)*dx(v)+dy(dxdOm1)*dy(v)))
                        -int2d(Th)(dx(dOm1)*v);

problem gradyPhi1(dydOm1,v) = int2d(Th)(dydOm1*v + alpha^2*(dx(dydOm1)*dx(v)+dy(dydOm1)*dy(v)))
                        -int2d(Th)(dy(dOm1)*v);

gradxPhi1;
gradyPhi1;

problem laplace1(lapldOm1,v) = int2d(Th)(lapldOm1*v + alpha^2*(dx(lapldOm1)*dx(v)+dy(lapldOm1)*dy(v)))
                        -int2d(Th)((dx(dxdOm1) + dy(dydOm1))*v);

laplace1;

problem gradxPhi2(dxdOm2,v) = int2d(Th)(dxdOm2*v + alpha^2*(dx(dxdOm2)*dx(v)+dy(dxdOm2)*dy(v)))
                        -int2d(Th)(dx(dOm2)*v);

problem gradyPhi2(dydOm2,v) = int2d(Th)(dydOm2*v + alpha^2*(dx(dydOm2)*dx(v)+dy(dydOm2)*dy(v)))
                        -int2d(Th)(dy(dOm2)*v);

gradxPhi2;
gradyPhi2;

problem laplace2(lapldOm2,v) = int2d(Th)(lapldOm2*v + alpha^2*(dx(lapldOm2)*dx(v)+dy(lapldOm2)*dy(v)))
                        -int2d(Th)((dx(dxdOm2) + dy(dydOm2))*v);

laplace2;

real q = 3.5, r = 3.5;
w1 = 2/(1+abs(dOm1)^q*abs(lapldOm1)^r);
w2 = 2/(1+abs(dOm2)^q*abs(lapldOm2)^r);

fespace Vh12(Th12,P1);
Vh12 u12, u21, g12, rhs12, rhs21, v12;

problem uTerm12(u12,v12) = int1d(Th12,lsLabel)(chi2*u12*v12) + int2d(Th12)(w2*(dxdOm2*dx(u12)+dydOm2*dy(u12))*(dxdOm2*dx(v12)+dydOm2*dy(v12)))
                        - int2d(Th12,pOm1)(chi1*((p*abs(dOm2)^p)/(dOm2^(2*p+1)+1e-6))*v12);

uTerm12;

problem uTerm21(u21,v12) = int1d(Th12,pOm1)(chi1*u21*v12) + int2d(Th12)(w1*(dxdOm1*dx(u21)+dydOm1*dy(u21))*(dxdOm1*dx(v12)+dydOm1*dy(v12)))
                        - int2d(Th12,lsLabel)(chi2*((p*abs(dOm1)^p)/(dOm1^(2*p+1)+1e-6))*v12);

uTerm21;

rhs12 = P12^(1+p)*(-chi1*abs(dOm2)^p/(dOm2^(2*p+1)+1e-6)*(dxdOm2*nx+dydOm2*ny)+chi1*kappa/(p*abs(dOm2)^p+1e-6)+chi2*u12/p);
rhs21 = P21^(1+p)*(-chi2*abs(dOm1)^p/(dOm1^(2*p+1)+1e-6)*(dxdOm1*nx+dydOm1*ny)+chi2*kappa/(p*abs(dOm1)^p+1e-6)+chi1*u21/p);

problem velext(g12,v12) = int2d(Th12)(g12*v12 + beta^2*(dx(g12)*dx(v12)+dy(g12)*dy(v12)))
                        -int1d(Th12,lsLabel)(beta*(p21*rhs12+p12*rhs21)*v12);

velext;
g = g12;

exportArray(g[]);