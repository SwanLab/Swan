IMPORT "io.edp"
load "distance"

mesh Th = importMesh("Th");

/* Finite Element spaces */
fespace Vh(Th,P1);
fespace Vh0(Th,P0);

/* Initialization of the Level Set function */
func real levelSet1Init() {
  real ls, xp, yp;
  xp = cos(pi/6)*(x-0.5) + sin(pi/6)*(y-0.75);
  yp = -sin(pi/6)*(x-0.5) + cos(pi/6)*(y-0.75);
  ls = xp^2.0/(0.75^2) + yp^2.0/(0.25^2) - 1.0;
  return(ls);
}
func real levelSet2InitX() {
  real nHX = 3.0, lX = 1.0, fX = -pi;
  real lsx;
  lsx = cos((nHX+1)*(x+1)*pi/lX+fX);
  return(lsx);
}
func real levelSet2InitY() {
  real nHY = 2.0, lY = 1.0, fY = -pi/2;
  real lsy;
  lsy = cos((nHY+1)*y*pi/lY+fY);
  return(lsy);
}

Vh phio1, phio2x, phio2y, phio2, phi1Aux, phi1, phi2;
phio1  = levelSet1Init();
phio2x = levelSet2InitX();
phio2y = levelSet2InitY();

/* Level set 1*/
distance(Th,phio1,phi1[]);

for (int i = 0; i < Th.nbe; i++) {
    phio1[][Th.be(i)[0]] = 0.;
    phio1[][Th.be(i)[1]] = 0.;
}
distance(Th,phio1,phi1Aux[]);

/* Level set 2*/
for (int i = 0; i < Vh.ndof; ++i) {
  phio2[][i] = phio2x[][i]*phio2y[][i] - 0.3;
  if (phi1Aux[][i]>-0.05) {
    phio2[][i] = -1;
  }
}
distance(Th,phio2,phi2[]);

exportArray(phi1[]);
exportArray(phi2[]);
